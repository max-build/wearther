{
  "name": "wearther",
  "version": "1.0.0",
  "description": "Weather-aware, culturally appropriate outfit recommendations",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:css && tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "npm run build:css && tsc -p tsconfig.client.json && concurrently -k \"tailwindcss -i styles/app.css -o public/styles.css --watch\" \"tsc -p tsconfig.client.json --watch --preserveWatchOutput\" \"tsx watch --env-file-if-exists=.env src/server.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build:css": "tailwindcss -i styles/app.css -o public/styles.css --minify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "compression": "^1.8.2",
    "country-state-city": "^3.2.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "daisyui": "^5.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
