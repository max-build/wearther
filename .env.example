# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional
PORT=3000
# Claude model + effort used for outfit recommendations
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low
# Recommendations allowed per client IP per hour
RATE_LIMIT_PER_HOUR=6
# Set to the number of reverse proxies in front of the app (e.g. 1 behind nginx)
# so rate limiting keys on the real client IP. Leave 0 when exposed directly.
TRUST_PROXY=0
